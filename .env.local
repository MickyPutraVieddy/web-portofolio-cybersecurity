# Copy to .env.local and fill in. Generate the secrets with:  node scripts/admin-setup.mjs "your-password"
SESSION_SECRET=cK9iM-9w6HX9ZIW-feouojWNl1AUtGLHZ3rP-AnpRXZeIwHO9QDndE0cyY3hoEEa
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:gk1yHzZdTuMx7XJJrDqhAQ==:IcaN66PH265ffHFE+te4FKI+f19shzhwCUMV9/R99Anv33mLKu8wcBj73teHVypC1FnG1blLRomM/o1McNiNfw==
# Optional and normally unused: turn Google Authenticator on from Admin > Security instead. Setting this fixes the secret in the environment.
ADMIN_TOTP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# REQUIRED in production for passkeys: your public https origin, e.g. https://yourname.com (passkeys are bound to this domain)
SITE_URL=
# Storage: on Vercel add an Upstash Redis integration (sets KV_REST_API_URL / KV_REST_API_TOKEN automatically).
# Locally / on your own server the content is kept in ./.data (override with DATA_DIR).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Contact form delivery (server-only; the form answers "not active yet" until all three are set).
# Uses the Resend HTTPS API (https://resend.com). CONTACT_FROM_EMAIL must be a sender/domain verified at the provider.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional passkey overrides: WEBAUTHN_ORIGIN (defaults to SITE_URL) and WEBAUTHN_RP_ID (defaults to the origin's hostname; may be a parent domain)
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
